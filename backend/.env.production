# Backend Environment Variables for Render
# Copy these to Render Environment Variables dashboard

# Database URL (will be provided by Render PostgreSQL)
DATABASE_URL=postgresql://user:password@db-host:5432/inventory_db

# Python Configuration
PYTHONUNBUFFERED=1

# Environment
ENVIRONMENT=production

# API Port (Render automatically sets this, but we can override)
PORT=10000

# CORS Settings - Update with your Netlify URL
CORS_ORIGINS=https://your-app-name.netlify.app

# Other settings
LOG_LEVEL=INFO
